# --- Umbrales PSI ---
PSI_CRITICAL_THRESHOLD=0.20
PSI_WARNING_THRESHOLD=0.10
PSI_CRITICAL_PCT_FORCE=0.50
PSI_WARNING_PCT_ALARM=0.30

# --- Prevención de Fuga (Churn) Monitor ---
CHURN_EVALUATE_URL=http://localhost:8001/fuga/monitor/evaluate
CHURN_MATURATION_DAYS=1
CHURN_MIN_FEEDBACK_SAMPLES=10
CHURN_MONITOR_ENABLED=true
CHURN_MONITOR_INTERVAL_HOURS=6
CHURN_RECALL_THRESHOLD=0.70
CHURN_RELOAD_URL=http://localhost:8000/churn/reload
