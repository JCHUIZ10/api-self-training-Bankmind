# --- PostgreSQL (Configuración del Pool)---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- API de Predicción ---
PREDICTION_API_URL=http://localhost:8000/api/atm/v1/withdrawal/off-time
